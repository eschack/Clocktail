<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Clocktail.Broker</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>The elevated broker: the single process that performs GPU writes, behind a user-only named pipe.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Clocktail.Core\Clocktail.Core.csproj" />
    <ProjectReference Include="..\Clocktail.Domain\Clocktail.Domain.csproj" />
  </ItemGroup>

</Project>
